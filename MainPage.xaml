<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhoneGamepad.MainPage"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="10">
        <!-- 手柄区域 -->
        <AbsoluteLayout x:Name="GamepadLayout"
                        InputTransparent="False">

            <!-- 空白触摸区域 -->
            <Button
                x:Name="TouchBackground"
                Text=""
                BackgroundColor="Transparent"
                BorderWidth="0"
                Opacity="0"
                IsEnabled="True"
                InputTransparent="False"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                ZIndex="-1000" />

            <!-- LT -->
            <Button
                x:Name="LTButton"
                AutomationId="LTButton"
                Text="LT"
                FontSize="16"
                WidthRequest="120"
                HeightRequest="50"
                Pressed="LTButton_Pressed"
                Released="LTButton_Released"
                AbsoluteLayout.LayoutBounds="0.08,0.08,70,45"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- LB -->
            <Button
                x:Name="LBButton"
                AutomationId="LBButton"
                Text="LB"
                FontSize="16"
                WidthRequest="120"
                HeightRequest="50"
                Pressed="LBButton_Pressed"
                Released="LBButton_Released"
                AbsoluteLayout.LayoutBounds="0.08,0.19,70,45"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- 左摇杆 -->
            <Grid
                x:Name="LeftJoystick"
                AutomationId="LeftJoystick"
                WidthRequest="190"
                HeightRequest="190"
                AbsoluteLayout.LayoutBounds="0.13,0.62,190,190"
                AbsoluteLayout.LayoutFlags="PositionProportional">

                <Border
                    x:Name="JoystickBase"
                    WidthRequest="160"
                    HeightRequest="160"
                    StrokeThickness="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="80" />
                    </Border.StrokeShape>
                </Border>

                <Ellipse
                    x:Name="JoystickKnob"
                    WidthRequest="55"
                    HeightRequest="55"
                    BackgroundColor="Gray"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <BoxView BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="Joystick_PanUpdated" />
                    </BoxView.GestureRecognizers>
                </BoxView>
            </Grid>

            <!-- L3 -->
            <Button
                x:Name="L3Button"
                AutomationId="L3Button"
                Text="L3"
                FontSize="14"
                WidthRequest="55"
                HeightRequest="35"
                Pressed="L3Button_Pressed"
                Released="L3Button_Released"
                AbsoluteLayout.LayoutBounds="0.13,0.88,55,35"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- D-Pad -->
            <Grid
                x:Name="DPad"
                AutomationId="DPad"
                WidthRequest="130"
                HeightRequest="130"
                AbsoluteLayout.LayoutBounds="0.30,0.62,190,190"
                AbsoluteLayout.LayoutFlags="PositionProportional">

                <Button
                    x:Name="DPadUpButton"
                    Text="▲"
                    FontSize="18"
                    WidthRequest="45"
                    HeightRequest="45"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Pressed="DPadUp_Pressed"
                    Released="DPadUp_Released" />

                <Button
                    x:Name="DPadDownButton"
                    Text="▼"
                    FontSize="18"
                    WidthRequest="45"
                    HeightRequest="45"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Pressed="DPadDown_Pressed"
                    Released="DPadDown_Released" />

                <Button
                    x:Name="DPadLeftButton"
                    Text="◀"
                    FontSize="18"
                    WidthRequest="45"
                    HeightRequest="45"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Pressed="DPadLeft_Pressed"
                    Released="DPadLeft_Released" />

                <Button
                    x:Name="DPadRightButton"
                    Text="▶"
                    FontSize="18"
                    WidthRequest="45"
                    HeightRequest="45"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Pressed="DPadRight_Pressed"
                    Released="DPadRight_Released" />
            </Grid>

            <!-- Back -->
            <Button
                x:Name="BackButton"
                AutomationId="BackButton"
                Text="-"
                FontSize="24"
                WidthRequest="40"
                HeightRequest="40"
                Pressed="BackButton_Pressed"
                Released="BackButton_Released"
                AbsoluteLayout.LayoutBounds="0.46,0.15,55,32"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <Button
                x:Name="HomeButton"
                AutomationId="HomeButton"
                Text="HOME"
                FontSize="10"
                WidthRequest="60"
                HeightRequest="40"
                Pressed="HomeButton_Pressed"
                Released="HomeButton_Released"
                AbsoluteLayout.LayoutBounds="0.50,0.15,55,32"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- Start -->
            <Button
                x:Name="StartButton"
                AutomationId="StartButton"
                Text="+"
                FontSize="20"
                WidthRequest="40"
                HeightRequest="40"
                Pressed="StartButton_Pressed"
                Released="StartButton_Released"
                AbsoluteLayout.LayoutBounds="0.54,0.15,55,32"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- 右摇杆 -->
            <Grid
                x:Name="RightJoystick"
                AutomationId="RightJoystick"
                WidthRequest="190"
                HeightRequest="190"
                AbsoluteLayout.LayoutBounds="0.63,0.72,190,190"
                AbsoluteLayout.LayoutFlags="PositionProportional">

                <Border
                    WidthRequest="160"
                    HeightRequest="160"
                    StrokeThickness="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="80" />
                    </Border.StrokeShape>
                </Border>

                <Ellipse
                    x:Name="RightJoystickKnob"
                    WidthRequest="55"
                    HeightRequest="55"
                    BackgroundColor="Gray"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <BoxView BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="RightJoystick_PanUpdated" />
                    </BoxView.GestureRecognizers>
                </BoxView>
            </Grid>

            <!-- R3 -->
            <Button
                x:Name="R3Button"
                AutomationId="R3Button"
                Text="R3"
                FontSize="14"
                WidthRequest="55"
                HeightRequest="35"
                Pressed="R3Button_Pressed"
                Released="R3Button_Released"
                AbsoluteLayout.LayoutBounds="0.63,0.94,55,35"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- ABXY -->
            <Grid
                x:Name="ABXY"
                AutomationId="ABXY"
                WidthRequest="190"
                HeightRequest="190"
                AbsoluteLayout.LayoutBounds="0.84,0.57,190,190"
                AbsoluteLayout.LayoutFlags="PositionProportional">

                <Button
                    x:Name="XButton"
                    Text="X"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Pressed="XButton_Pressed"
                    Released="XButton_Released" />

                <Button
                    x:Name="BButton"
                    Text="B"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Pressed="BButton_Pressed"
                    Released="BButton_Released" />

                <Button
                    x:Name="YButton"
                    Text="Y"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Pressed="YButton_Pressed"
                    Released="YButton_Released" />

                <Button
                    x:Name="AButton"
                    Text="A"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Pressed="AButton_Pressed"
                    Released="AButton_Released" />
            </Grid>

            <!-- RT -->
            <Button
                x:Name="RTButton"
                AutomationId="RTButton"
                Text="RT"
                FontSize="16"
                WidthRequest="120"
                HeightRequest="50"
                Pressed="RTButton_Pressed"
                Released="RTButton_Released"
                AbsoluteLayout.LayoutBounds="0.92,0.08,70,45"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- RB -->
            <Button
                x:Name="RBButton"
                AutomationId="RBButton"
                Text="RB"
                FontSize="16"
                WidthRequest="120"
                HeightRequest="50"
                Pressed="RBButton_Pressed"
                Released="RBButton_Released"
                AbsoluteLayout.LayoutBounds="0.92,0.19,70,45"
                AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- 当前选中控件的高亮框 -->
            <Border
                x:Name="SelectionBorder"
                IsVisible="False"
                Stroke="Lime"
                StrokeThickness="3"
                BackgroundColor="Transparent"
                InputTransparent="True"
                ZIndex="998">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
            </Border>

            <!-- 编辑模式拖动层 -->
            <Grid
                x:Name="EditDragLayer"
                BackgroundColor="Transparent"
                IsVisible="False"
                InputTransparent="True"
                ZIndex="999"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All" />
        </AbsoluteLayout>

        <!-- 顶部 UI -->
        <VerticalStackLayout
            ZIndex="1000"
            InputTransparent="False"
            HorizontalOptions="Fill"
            VerticalOptions="Start">

            <!-- 状态 -->
            <Label
                x:Name="StatusLabel"
                Text="手柄未连接"
                FontSize="16"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,0,0,5" />

            <!-- 编辑按钮 -->
            <!-- 编辑控制区域 -->
            <VerticalStackLayout
                x:Name="EditControlArea"
                HorizontalOptions="Center"
                Spacing="2">

                <!-- 编辑按钮 -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="8">    

                    <Button
                        x:Name="EditLayoutButton"
                        Text="编辑布局"
                        FontSize="10"
                        Padding="4,2"
                        HeightRequest="28"
                        Clicked="EditLayoutButton_Clicked" />

                    <Button
                        x:Name="SwapABXYButton"
                        Text="交换 ABXY"
                        FontSize="10"
                        Padding="4,2"
                        HeightRequest="28"
                        Clicked="SwapABXYButton_Clicked"
                        IsVisible="False" />

                    <Button
                        x:Name="ResetLayoutButton"
                        Text="恢复默认"
                        FontSize="10"
                        Padding="4,2"
                        HeightRequest="28"
                        Clicked="ResetLayoutButton_Clicked"
                        IsVisible="False" />

                    <Button
                        x:Name="FinishEditButton"
                        Text="完成"
                        FontSize="10"
                        Padding="4,2"
                        HeightRequest="28"
                        Clicked="FinishEditButton_Clicked"
                        IsVisible="False" />
                </HorizontalStackLayout>

                <!-- 按键大小 -->
                <HorizontalStackLayout
                    x:Name="SizeEditor"
                    IsVisible="False"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8"
                    Margin="0,4,0,0">

                    <Label
                        x:Name="SizeLabel"
                        Text="大小：100%"
                        FontSize="14"
                        VerticalOptions="Center" />

                    <Slider
                        x:Name="SizeSlider"
                        Minimum="0.5"
                        Maximum="1.5"
                        Value="1"
                        WidthRequest="180"
                        VerticalOptions="Center"
                        ValueChanged="SizeSlider_ValueChanged" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>